# KINGBOT local Windows deployment
# scripts/windows-start.ps1 creates .env and generates these secrets automatically.

POSTGRES_DB=kingbot
POSTGRES_USER=kingbot_owner
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__

NODE_ENV=production
FRONTEND_ORIGIN=https://botking-automation.github.io
FRONTEND_ORIGINS=https://botking-automation.github.io

# Generated automatically on first start. Do not share or commit .env.
SESSION_SECRET=__GENERATE_SESSION_SECRET__
BROKER_CREDENTIALS_KEY=__GENERATE_BROKER_KEY__
KINGBOT_ML_SIGNAL_SECRET=__GENERATE_ML_SECRET__

# Optional integrations. Add your own keys privately to .env.
FIREBASE_SERVICE_ACCOUNT_JSON=
KINGBOT_ADMIN_EMAILS=
TWELVE_DATA_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
TRADINGVIEW_WEBHOOK_SECRET=

# KINGBOT AI execution gate remains required.
KINGBOT_AI_STRATEGIES_REQUIRED=true
KINGBOT_AI_EXTERNAL_PROVIDER=none
KINGBOT_ML_SIGNAL_TIMEOUT_MS=10000
KINGBOT_ML_TRAIN_TIMEOUT_MS=180000
KINGBOT_ML_TRAIN_SPACING_MS=2500
KINGBOT_ML_MAX_MODELS=50
KINGBOT_ML_MAX_MARKETS=12
KINGBOT_ML_MIN_VALIDATION_MARKETS=3
KINGBOT_ML_MAX_BARS_PER_MARKET=600
KINGBOT_ML_MAX_BODY_BYTES=1500000
KINGBOT_ML_ARTIFACT_TIMEOUT_SEC=60

# Use the local ML service on the private Docker network.
KINGBOT_ML_SIGNAL_URL=http://ml-signal:10000

# Optional local market-data configuration.
TWELVE_DATA_SYMBOLS=XAU/USD,EUR/USD,GBP/USD,USD/JPY,BTC/USD
TWELVE_DATA_RECONNECT_MS=5000
TWELVE_DATA_CATALOG_TTL_MS=21600000

# Optional admin configuration.
MPESA_RECEIVER_PHONE=
