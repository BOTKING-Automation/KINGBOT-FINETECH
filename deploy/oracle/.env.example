# Copy this file to .env locally on the VM. Never commit .env or share its contents.
# Keep passwords/secrets out of GitHub and chat.

POSTGRES_DB=kingbot_fintech
POSTGRES_USER=kingbot_app
# Use a 64-character hex password. Keep it identical in POSTGRES_PASSWORD and DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_NEW_64_CHAR_HEX_PASSWORD
DATABASE_URL=postgresql://kingbot_app:REPLACE_WITH_NEW_64_CHAR_HEX_PASSWORD@db:5432/kingbot_fintech
# This is for PostgreSQL on the private Docker network only. Do not use for a public database.
DATABASE_SSL=disable

NODE_ENV=production
PORT=10000
API_DOMAIN=api.gibsonfx.online
FRONTEND_ORIGINS=https://botking-automation.github.io,https://kingbot-finetech.vercel.app,https://gibsonfx.online,https://www.gibsonfx.online

# CRITICAL: when migrating an existing Render DB, reuse the exact existing value from Render.
# Changing this key makes previously encrypted broker credentials unreadable.
BROKER_CREDENTIALS_KEY=REUSE_EXISTING_RENDER_VALUE_FOR_MIGRATION

# Copy the existing JSON value from Render if Firebase-backed auth is used.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Safe defaults for the first deployment. Keep both until the demo test is approved.
KINGBOT_EXECUTION_HALT=1
KINGBOT_LIVE_EXECUTION_ENABLED=0
KINGBOT_LIVE_AUTH_REQUIRED=true
WORKER_STANDBY=1
KINGBOT_AI_STRATEGIES_REQUIRED=true
KINGBOT_WORKER_ID=oracle-worker-1

# Internal Docker-only ML endpoint. The same secret must be supplied to API, worker, and ML service.
KINGBOT_ML_SIGNAL_URL=http://ml-signal:10001
KINGBOT_ML_SIGNAL_PORT=10001
KINGBOT_ML_SIGNAL_SECRET=REPLACE_WITH_NEW_64_CHAR_HEX_ML_SECRET
KINGBOT_ML_MIN_BARS=150
KINGBOT_ML_FORWARD_BARS=3
KINGBOT_ML_LABEL_ATR=0.35
KINGBOT_ML_MAX_MODELS=50
KINGBOT_ML_MAX_MARKETS=12
KINGBOT_ML_MAX_BARS_PER_MARKET=320
KINGBOT_ML_MAX_BODY_BYTES=1500000

# Copy required non-Oracle integration variables from Render into this local file as needed.
# Examples may include market-data or broker API keys. Never paste secret values into GitHub.
