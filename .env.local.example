# Copy to .env.local. Replace every REPLACE_ value with a private random secret.
# Never commit .env.local or share its contents.

KINGBOT_DB_USER=kingbot
KINGBOT_DB_PASSWORD=REPLACE_WITH_PRIVATE_RANDOM_SECRET
SESSION_SECRET=REPLACE_WITH_PRIVATE_RANDOM_SECRET_AT_LEAST_32_CHARS
BROKER_CREDENTIALS_KEY=REPLACE_WITH_PRIVATE_RANDOM_SECRET_AT_LEAST_32_CHARS
KINGBOT_ML_SIGNAL_SECRET=REPLACE_WITH_PRIVATE_RANDOM_SECRET_AT_LEAST_32_CHARS

# Keep execution disabled. The worker is not part of the default Compose profile.
KINGBOT_WORKER_STANDBY=1

# Optional service integrations. Keep empty until configured and tested.
KINGBOT_ADMIN_EMAILS=
FIREBASE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=
BREVO_API_KEY=
MAIL_FROM_EMAIL=
TWELVE_DATA_API_KEY=
TRADINGVIEW_WEBHOOK_SECRET=
DERIV_OAUTH_CLIENT_ID=
DERIV_DIRECT_APP_ID=
