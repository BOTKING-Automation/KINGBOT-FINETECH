//@version=5
indicator("KINGBOT TECH PRO | SMC + Patterns + MTF Dashboard", shorttitle="KINGBOT PRO", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500, max_bars_back=500)

//==============================================================================
//  KINGBOT TECH PRO  -  owned by GIBSONFX TECH
//  Chart patterns | Candlestick patterns | Smart Money Concepts | MTF dashboard
//  Session Analyzer (opening / closing range)
//  Confluence-scored signals with Entry / Stop Loss / TP1-TP3 and live trade tracking
//  All signals are generated on CONFIRMED bar closes (no repainting of signals).
//==============================================================================

// -- 1 | DASHBOARD -------------------------------------------------------------
G_DASH      = "1 | Dashboard"
dashMode    = input.string("Mini (top)", "Dashboard display", options = ["Mini (top)", "Full", "Off"], group = G_DASH, tooltip = "Mini keeps a small status strip at the top. Full shows all analysis panels. Off removes the dashboard and leaves the chart clear.")
dashPosStr  = input.string("Top Right", "Dashboard position", options = ["Top Right", "Top Left"], group = G_DASH)
dashSizeStr = input.string("Small", "Full dashboard text size", options = ["Tiny", "Small", "Normal", "Large"], group = G_DASH)
tfA = input.timeframe("15",  "MTF row 1", group = G_DASH, tooltip = "Choose timeframes equal to or higher than the chart timeframe.")
tfB = input.timeframe("60",  "MTF row 2", group = G_DASH)
tfC = input.timeframe("240", "MTF row 3", group = G_DASH)
tfD = input.timeframe("D",   "MTF row 4", group = G_DASH)
tfE = input.timeframe("W",   "MTF row 5", group = G_DASH)
secSig    = input.bool(true, "Show section: Signal (Full mode)", group = G_DASH)
secMTF    = input.bool(true, "Show section: Multi-timeframe (Full mode)", group = G_DASH)
secMkt    = input.bool(true, "Show section: Market / Smart Money (Full mode)", group = G_DASH)
secPerf   = input.bool(true, "Show section: Performance (Full mode)", group = G_DASH)
secSes    = input.bool(true, "Show section: Sessions (Full mode)", group = G_DASH)

// -- 2 | STYLE -----------------------------------------------------------------
G_STY   = "2 | Style"
