colBear = input.color(#FF1744, "Bearish", group = G_STY)
colNeu  = input.color(#8A93A6, "Neutral", group = G_STY)
colGold = input.color(#F5C518, "Accent (gold)", group = G_STY)
colBg   = input.color(color.new(#0A0E1A, 6), "Dashboard background", group = G_STY)
showEMA = input.bool(false, "Show EMA 50 / 200", group = G_STY)

// -- 3 | DRAWINGS ALLOWED PER CHART TIMEFRAME ---------------------------------
G_TF = "3 | Allow pattern drawings on chart timeframe"
allowM1  = input.bool(true,  "1m - 3m",   group = G_TF)
allowM5  = input.bool(true,  "5m - 14m",  group = G_TF)
allowM15 = input.bool(true,  "15m - 29m", group = G_TF)
allowM30 = input.bool(true,  "30m - 59m", group = G_TF)
allowH1  = input.bool(true,  "1H - 3H",   group = G_TF)
allowH4  = input.bool(true,  "4H - 23H",  group = G_TF)
allowD   = input.bool(true,  "Daily",     group = G_TF)
allowW   = input.bool(true,  "Weekly+",   group = G_TF)
tfApplySMC = input.bool(true, "Apply this timeframe filter to SMC drawings too", group = G_TF)

// -- 4 | CHART PATTERNS -------------------------------------------------------
G_PAT   = "4 | Chart patterns"
pDT     = input.bool(true, "Double Top / Double Bottom", group = G_PAT)
pHS     = input.bool(true, "Head & Shoulders / Inverse", group = G_PAT)
pTri    = input.bool(true, "Triangles (Ascending / Descending / Symmetrical)", group = G_PAT)
pWedge  = input.bool(true, "Rising / Falling Wedges", group = G_PAT)
pChan   = input.bool(true, "Channels & Ranges", group = G_PAT)
pivLen  = input.int(8, "Pivot length", minval = 3, maxval = 30, group = G_PAT, tooltip = "Bars left/right to confirm a swing. Larger = bigger, rarer patterns.")
patTol  = input.float(0.8, "Equal-level tolerance (x ATR)", minval = 0.1, step = 0.1, group = G_PAT)
minDepth = input.float(1.5, "Minimum pattern depth (x ATR)", minval = 0.5, step = 0.1, group = G_PAT)
pLabelsOn = input.bool(true, "Show pattern labels", group = G_PAT)

// -- 5 | CANDLESTICK PATTERNS -------------------------------------------------
G_CDL  = "5 | Candlestick patterns"
cEng   = input.bool(true, "Engulfing", group = G_CDL)
cPin   = input.bool(true, "Pin bar / Hammer / Shooting star", group = G_CDL)
cStar  = input.bool(true, "Morning / Evening star", group = G_CDL)
cIn    = input.bool(false, "Inside bar", group = G_CDL)

// -- 6 | SMART MONEY CONCEPTS -------------------------------------------------
G_SMC   = "6 | Smart Money Concepts"
sStruct = input.bool(true, "Market structure (BOS / CHoCH)", group = G_SMC)
sOB     = input.bool(true, "Order blocks", group = G_SMC)
