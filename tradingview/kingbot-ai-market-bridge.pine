//@version=6
indicator("KINGBOT AI Market Bridge", overlay=true, max_labels_count=50)

// KINGBOT receives this snapshot through a TradingView webhook.
// Create one TradingView alert per symbol/chart using: "Any alert() function call".
// Webhook URL:
// https://<YOUR-KINGBOT-API>/api/webhooks/tradingview?secret=<YOUR_TRADINGVIEW_WEBHOOK_SECRET>

ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
rsi14 = ta.rsi(close, 14)
[macdLine, macdSignal, _] = ta.macd(close, 12, 26, 9)
atr14 = ta.atr(14)

ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow(low, 5, 5)
lastResistance = ta.valuewhen(not na(ph), ph, 0)
lastSupport = ta.valuewhen(not na(pl), pl, 0)

bullBos = not na(lastResistance) and close > lastResistance
bearBos = not na(lastSupport) and close < lastSupport

bullSweep = not na(lastSupport) and low < lastSupport and close > lastSupport
bearSweep = not na(lastResistance) and high > lastResistance and close < lastResistance

bullFvg = low > high[2]
bearFvg = high < low[2]

trend = ema20 > ema50 and close > ema20 ? "BULLISH" : ema20 < ema50 and close < ema20 ? "BEARISH" : "NEUTRAL"
bos = bullBos ? "BULLISH" : bearBos ? "BEARISH" : "NONE"
liquidity = bullSweep ? "BULLISH" : bearSweep ? "BEARISH" : "NONE"
fvg = bullFvg or bearFvg

// Human-readable plots for chart confirmation.
plot(ema20, "EMA 20", color=color.aqua)
plot(ema50, "EMA 50", color=color.orange)
plot(lastSupport, "Support", color=color.new(color.green, 35), style=plot.style_linebr)
plot(lastResistance, "Resistance", color=color.new(color.red, 35), style=plot.style_linebr)

snapshot = "{" +
  "\"source\":\"TradingView\"," +
  "\"symbol\":\"" + syminfo.ticker + "\"," +
  "\"timeframe\":\"" + timeframe.period + "\"," +
  "\"barTime\":" + str.tostring(time) + "," +
  "\"open\":" + str.tostring(open) + "," +
  "\"high\":" + str.tostring(high) + "," +
  "\"low\":" + str.tostring(low) + "," +
  "\"close\":" + str.tostring(close) + "," +
  "\"volume\":" + str.tostring(volume) + "," +
  "\"ema20\":" + str.tostring(ema20) + "," +
  "\"ema50\":" + str.tostring(ema50) + "," +
  "\"rsi14\":" + str.tostring(rsi14) + "," +
  "\"macd\":" + str.tostring(macdLine) + "," +
  "\"macdSignal\":" + str.tostring(macdSignal) + "," +
  "\"atr14\":" + str.tostring(atr14) + "," +
  "\"trend\":\"" + trend + "\"," +
  "\"bos\":\"" + bos + "\"," +
  "\"choch\":\"NONE\"," +
  "\"liquiditySweep\":\"" + liquidity + "\"," +
  "\"fvg\":" + (fvg ? "true" : "false") + "," +
  "\"support\":" + str.tostring(lastSupport) + "," +
  "\"resistance\":" + str.tostring(lastResistance) +
  "}"

if barstate.isconfirmed
    alert(snapshot, alert.freq_once_per_bar_close)
